# AegisForge Environment Configuration
# Copy to .env and customize for your environment

# ============================================================
# GENERAL
# ============================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json
TZ=UTC

# ============================================================
# REGISTRY & IMAGES
# ============================================================
REGISTRY=docker.io
ORG=willey2003
VERSION=latest
IMAGE_PULL_POLICY=Always

# ============================================================
# DATABASE (PostgreSQL)
# ============================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aegisforge
POSTGRES_USER=aegisforge
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# ============================================================
# EVENT BACKBONE (Redpanda/Kafka)
# ============================================================
REDPANDA_BROKERS=redpanda:9092
REDPANDA_TOPIC_EVENTS=security-events
REDPANDA_TOPIC_ALERTS=security-alerts
REDPANDA_TOPIC_INCIDENTS=security-incidents
REDPANDA_TOPIC_AUDIT=audit-logs
REDPANDA_CONSUMER_GROUP=aegisforge-detection

# ============================================================
# VECTOR DATABASE (Qdrant)
# ============================================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=security-knowledge
QDRANT_VECTOR_SIZE=384

# ============================================================
# OBJECT STORAGE (MinIO)
# ============================================================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_EVIDENCE=aegisforge-evidence
MINIO_BUCKET_ARTIFACTS=aegisforge-artifacts
MINIO_USE_SSL=false

# ============================================================
# AI / OLLAMA
# ============================================================
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_EMBEDDING_MODEL=all-MiniLM-L6-v2
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_THREAD=4
OLLAMA_TEMPERATURE=0.1

# Embedding service (sentence-transformers)
EMBEDDING_SERVICE_HOST=ai-copilot
EMBEDDING_SERVICE_PORT=8003
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# ============================================================
# AI SAFETY
# ============================================================
AI_REDACT_SECRETS=true
AI_REDACT_PII=true
AI_REDACT_IPS=true
AI_REDACT_TOKENS=true
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.1
AI_SYSTEM_PROMPT_STRICT=true

# ============================================================
# DETECTION ENGINE
# ============================================================
DETECTION_RULES_PATH=/etc/aegisforge/rules
DETECTION_CONSUMER_GROUP=aegisforge-detection
DETECTION_BATCH_SIZE=100
DETECTION_FLUSH_INTERVAL=5s
DETECTION_RULE_RELOAD_INTERVAL=300s

# ============================================================
# RESPONSE ORCHESTRATOR
# ============================================================
RESPONSE_NAMESPACE=aegisforge-lab
RESPONSE_DRY_RUN=true
RESPONSE_REQUIRE_APPROVAL=true
RESPONSE_ALLOWLIST_FILE=/etc/aegisforge/allowlist.yaml
RESPONSE_AUDIT_LOG=true
RESPONSE_CIRCUIT_BREAKER_THRESHOLD=5
RESPONSE_CIRCUIT_BREAKER_TIMEOUT=60s

# ============================================================
# EMULATION CONTROLLER
# ============================================================
EMULATION_NAMESPACE=aegisforge-lab
EMULATION_REQUIRE_APPROVAL=true
EMULATION_MAX_CONCURRENT=3
EMULATION_DEFAULT_DURATION=300s

# ============================================================
# API GATEWAY / AUTH
# ============================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
JWT_SECRET_KEY=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7

# Keycloak / OIDC (optional)
OIDC_ISSUER_URL=http://keycloak:8080/realms/aegisforge
OIDC_CLIENT_ID=aegisforge-console
OIDC_CLIENT_SECRET=dev-secret
OIDC_REDIRECT_URI=http://localhost:3000/callback

# ============================================================
# ANALYST CONSOLE
# ============================================================
CONSOLE_HOST=0.0.0.0
CONSOLE_PORT=3000
CONSOLE_API_URL=http://api-gateway:8000
CONSOLE_WS_URL=ws://api-gateway:8000/ws

# ============================================================
# SIMULATORS
# ============================================================
SIMULATOR_INTERVAL=30s
SIMULATOR_BATCH_SIZE=10
TARGET_API_PORT=8080

# ============================================================
# OBSERVABILITY
# ============================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=aegisforge
OTEL_EXPORTER_OTLP_INSECURE=true

PROMETHEUS_REMOTE_WRITE_URL=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ============================================================
# FALCO
# ============================================================
FALCO_ENABLED=true
FALCO_RULES_PATH=/etc/falco/rules

# ============================================================
# KEYCLOAK (optional)
# ============================================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_VENDOR=postgres
KEYCLOAK_DB_ADDR=postgres
KEYCLOAK_DB_DATABASE=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

# ============================================================
# DEVELOPMENT OVERRIDES
# ============================================================
DEV_MODE=true
DEV_SKIP_AUTH=false
DEV_SEED_DATA=true